# =============================================================================
# .env.example — шаблон переменных окружения для prod-деплоя на VPS
#
# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
#
# ВАЖНО: файл .env НЕ коммитится в git (добавлен в .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=chat_service
POSTGRES_DB=chat_service
# ВАЖНО: использовать только hex-символы (openssl rand -hex 20) —
# base64 пароли содержат / + = которые ломают URL-парсинг DSN
POSTGRES_PASSWORD=changeme_use_openssl_rand_hex_20

# DSN для сервисов (используется в конфигах через env-тег DATABASE_DSN)
DATABASE_DSN=postgres://chat_service:changeme_use_openssl_rand_hex_20@postgres:5432/chat_service?sslmode=disable

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Минимум 32 символа, случайная строка
JWT_SECRET=changeme_at_least_32_chars_secret_here

# -----------------------------------------------------------------------------
# Domain
# -----------------------------------------------------------------------------
# Домен с A-записью → IP VPS (87.228.112.251)
DOMAIN=beepru.ru

# -----------------------------------------------------------------------------
# Notification worker
# -----------------------------------------------------------------------------
# noop | devlog | webpush (Sprint 6)
PUSH_PROVIDER=noop

# -----------------------------------------------------------------------------
# Web Push (VAPID) — Sprint 6
# -----------------------------------------------------------------------------
# Сгенерировать один раз (реальные значения только в .env на VPS, не в git):
#   webpush.GenerateVAPIDKeys()  или  npx web-push generate-vapid-keys --json
VAPID_PRIVATE_KEY=changeme_vapid_private_key_base64url
VAPID_PUBLIC_KEY=changeme_vapid_public_key_base64url
VAPID_SUBJECT=mailto:admin@example.com

# -----------------------------------------------------------------------------
# Prometheus basic auth (для nginx)
# -----------------------------------------------------------------------------
METRICS_USER=admin
METRICS_PASSWORD=changeme_metrics_password_here
